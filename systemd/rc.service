# Reference template — do NOT install this file directly; paths are placeholders.
# Run "bash setup.sh --service" to generate and install a correctly substituted unit.
[Unit]
Description=Repeater Controller Daemon
After=network.target sound.target
Wants=sound.target

[Service]
Type=notify
User=<USER>
Group=audio
WorkingDirectory=<PROJECT_DIR>
ExecStart=<PROJECT_DIR>/venv/bin/python <PROJECT_DIR>/daemon.py <PROJECT_DIR>/repeater.toml
Restart=on-failure
RestartSec=5

# Reduce attack surface — daemon only needs audio and USB HID
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=<PROJECT_DIR>
PrivateTmp=true

[Install]
WantedBy=multi-user.target
